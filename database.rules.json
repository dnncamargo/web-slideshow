{
  "rules": {
    "live": {
      "current": {
        ".read": true,
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['publicationId', 'currentVersionId', 'revision']) && newData.child('publicationId').isString() && newData.child('publicationId').val().length > 0 && newData.child('currentVersionId').isString() && newData.child('currentVersionId').val().length > 0 && newData.child('revision').isNumber() && (newData.child('revision').val() % 1 == 0) && newData.child('revision').val() >= 0",
        "publicationId": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "currentVersionId": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "revision": {
          ".validate": "newData.isNumber() && (newData.val() % 1 == 0) && newData.val() >= 0"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "controlSpikes": {
      "$publicationId": {
        ".read": true,
        ".write": "auth != null && newData.hasChildren(['action', 'revision']) && newData.child('revision').isNumber() && (newData.child('action').val() === 'next' || newData.child('action').val() === 'previous')",
        "action": {
          ".validate": "newData.isString() && (newData.val() === 'next' || newData.val() === 'previous')"
        },
        "revision": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}

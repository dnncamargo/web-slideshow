# Firebase Web configuration.
# Copy to .env.local and fill with your Firebase project values.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_PLAYER_URL=
# Optional: used only by the temporary remote-control spike.
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Server-only Firebase Admin credentials for managed asset upload authorization.
# Never prefix these values with NEXT_PUBLIC_ or expose them to the browser.
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Vercel Blob variables supplied by the connected public Blob store.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
VERCEL_OIDC_TOKEN=

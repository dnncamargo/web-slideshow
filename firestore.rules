rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isPrivatePresentationOwner(userId) {
      // Private drafts remain readable/writable only by their authenticated
      // owner. Anonymous Firebase Auth counts as authenticated.
      return isSignedIn() && request.auth.uid == userId;
    }

    function publicationMetadataHasValidShape(publication) {
      return publication.keys().hasAll(['publicationId', 'currentVersionId', 'publishedRevision', 'publishedAt'])
        && publication.keys().hasOnly(['publicationId', 'currentVersionId', 'publishedRevision', 'publishedAt'])
        && publication.publicationId is string
        && publication.publicationId.size() > 0
        && publication.currentVersionId is string
        && publication.currentVersionId.size() > 0
        && publication.publishedRevision is int
        && publication.publishedRevision >= 0
        && publication.publishedAt is timestamp;
    }

    function draftHasValidShape() {
      let resource = request.resource.data;
      return resource.keys().hasAll(['presentationJson', 'createdAt', 'updatedAt', 'draftRevision'])
        && resource.keys().hasOnly(['presentationJson', 'createdAt', 'updatedAt', 'draftRevision', 'folderId', 'archivedAt', 'publication'])
        && resource.presentationJson is string
        && resource.presentationJson.size() > 0
        && resource.createdAt is timestamp
        && resource.updatedAt is timestamp
        && resource.draftRevision is int
        && resource.draftRevision >= 0
        && (!('folderId' in resource) || (resource.folderId is string && resource.folderId.size() > 0))
        && (!('archivedAt' in resource) || resource.archivedAt is timestamp)
        && (!('publication' in resource) || (resource.publication is map && publicationMetadataHasValidShape(resource.publication)));
    }

    // A published version must contain EXACTLY: presentationId, presentationJson,
    // publishedRevision, publishedAt. Reject extra private/persistence fields.
    function publishedVersionHasValidShape() {
      let resource = request.resource.data;
      return resource.keys().hasAll(['presentationId', 'presentationJson', 'publishedRevision', 'publishedAt'])
        && resource.keys().hasOnly(['presentationId', 'presentationJson', 'publishedRevision', 'publishedAt'])
        && resource.presentationId is string
        && resource.presentationId.size() > 0
        && resource.presentationJson is string
        && resource.presentationJson.size() > 0
        && resource.publishedRevision is int
        && resource.publishedRevision >= 0
        && resource.publishedAt == request.time;
    }

    // The public publication pointer must contain EXACTLY: currentVersionId,
    // publishedRevision, publishedAt. Reject extra fields.
    function publishedPointerHasValidShape() {
      let resource = request.resource.data;
      return resource.keys().hasAll(['currentVersionId', 'publishedRevision', 'publishedAt'])
        && resource.keys().hasOnly(['currentVersionId', 'publishedRevision', 'publishedAt'])
        && resource.currentVersionId is string
        && resource.currentVersionId.size() > 0
        && resource.publishedRevision is int
        && resource.publishedRevision >= 0
        && resource.publishedAt is timestamp;
    }

    // Find the private draft for the canonical presentation of the referenced
    // version, then validate the post-transaction pointer against that draft.
    //
    // existsAfter() establishes that the referenced immutable version and the
    // authenticated user's private draft exist before their data is evaluated,
    // so the Rules compiler never treats the document resources as nullable.
    function publishedPointerMatchesAuthoritativeDraft(publicationId, userId) {
      let resource = request.resource.data;
      let versionPath = /databases/$(database)/documents/publishedPresentations/$(publicationId)/versions/$(resource.currentVersionId);
      return existsAfter(versionPath)
        && publishedPointerMatchesExistingVersion(publicationId, userId, getAfter(versionPath));
    }

    function publishedPointerMatchesExistingVersion(publicationId, userId, version) {
      let resource = request.resource.data;
      let draftPath = /databases/$(database)/documents/users/$(userId)/presentations/$(version.data.presentationId);
      return existsAfter(draftPath)
        && publishedPointerMatchesValidDraft(publicationId, getAfter(draftPath), version, resource);
    }

    function publishedPointerMatchesValidDraft(publicationId, draft, version, resource) {
      return draft.data.publication.publicationId == publicationId
        && draft.data.publication.currentVersionId == resource.currentVersionId
        && draft.data.publication.publishedRevision == resource.publishedRevision
        && draft.data.publication.publishedAt == resource.publishedAt
        && draft.data.draftRevision == resource.publishedRevision
        && version.data.publishedRevision == resource.publishedRevision
        && version.data.publishedAt == resource.publishedAt
        && version.data.presentationJson == draft.data.presentationJson;
    }

    // The public pointer create/update is authorized when it is valid and
    // authoritative against the private draft.
    function publishedPointerIsAuthoritative(publicationId, userId) {
      return isSignedIn()
        && publishedPointerHasValidShape()
        && publishedPointerMatchesAuthoritativeDraft(publicationId, userId);
    }

    // Authorization for public version creation.
    //
    // Uses getAfter() because the publish transaction atomically creates the
    // public version AND updates the private draft publication pointer. The
    // post-transaction private draft must reference this exact public version.
    function publishedVersionMatchesAuthoritativeDraft(publicationId, versionId, userId) {
      let resource = request.resource.data;
      let draft = getAfter(
        /databases/$(database)/documents/users/$(userId)/presentations/$(resource.presentationId)
      );
      return draft != null
        && draft.data.publication.publicationId == publicationId
        && draft.data.publication.currentVersionId == versionId
        && draft.data.publication.publishedRevision == resource.publishedRevision
        && draft.data.publication.publishedAt == request.time
        && draft.data.draftRevision == resource.publishedRevision
        && resource.presentationJson == draft.data.presentationJson;
    }

    // A newly created version must atomically advance the public pointer so the
    // pointer's post-transaction currentVersionId points at this version.
    function publishedVersionMatchesNewPointer(publicationId, versionId) {
      let resource = request.resource.data;
      let pointer = getAfter(
        /databases/$(database)/documents/publishedPresentations/$(publicationId)
      );
      return pointer != null
        && pointer.data.currentVersionId == versionId
        && pointer.data.publishedRevision == resource.publishedRevision
        && pointer.data.publishedAt == resource.publishedAt;
    }

    // ------------------------------------------------------------
    // ARCHIVED PUBLICATION CLEANUP
    // ------------------------------------------------------------
    //
    // Lifecycle permissions that let the authenticated owner of an archived,
    // published presentation permanently remove its public publication record
    // and private draft during repository cleanup.

    // Shared archived-owner contract for publication lifecycle cleanup.
    //
    // Resolves ownership from the existing public publication chain:
    //   publicationId -> pointer -> pointer.currentVersionId -> current version
    //   -> currentVersion.presentationId -> authenticated private draft
    //   -> archivedAt -> publication metadata anchored to publicationId.
    //
    // Valid only while the pointer and current version still exist. Repository
    // cleanup preserves both until the final batch.
    function isArchivedPublicationOwner(publicationId, userId) {
      let pointer = get(
        /databases/$(database)/documents/publishedPresentations/$(publicationId)
      );
      return isSignedIn()
        && pointer != null
        && pointer.data.currentVersionId is string
        && pointer.data.currentVersionId.size() > 0
        && pointerVersionOwnedByArchivedDraft(
          publicationId,
          userId,
          pointer.data.currentVersionId
        );
    }

    // The pointer's current published version must exist, reference a valid
    // presentationId, and be anchored to the same archived private draft whose
    // publication metadata points at this exact current version.
    function pointerVersionOwnedByArchivedDraft(publicationId, userId, currentVersionId) {
      let version = get(
        /databases/$(database)/documents/publishedPresentations/$(publicationId)/versions/$(currentVersionId)
      );
      return version != null
        && version.data.presentationId is string
        && version.data.presentationId.size() > 0
        && archivedDraftOwnsPublication(
          publicationId,
          userId,
          version.data.presentationId
        )
        && draftPublicationMatchesCurrentVersion(
          userId,
          version.data.presentationId,
          currentVersionId
        );
    }

    // The authenticated user's private draft for a presentationId must exist,
    // be archived, and carry valid publication metadata anchored to the given
    // publicationId.
    function archivedDraftOwnsPublication(publicationId, userId, presentationId) {
      let draft = get(
        /databases/$(database)/documents/users/$(userId)/presentations/$(presentationId)
      );
      return draft != null
        && 'archivedAt' in draft.data
        && draft.data.archivedAt is timestamp
        && 'publication' in draft.data
        && draft.data.publication is map
        && publicationMetadataHasValidShape(draft.data.publication)
        && draft.data.publication.publicationId == publicationId;
    }

    // The draft's publication metadata must point at the given current version.
    function draftPublicationMatchesCurrentVersion(userId, presentationId, currentVersionId) {
      let draft = get(
        /databases/$(database)/documents/users/$(userId)/presentations/$(presentationId)
      );
      return draft != null
        && 'publication' in draft.data
        && draft.data.publication is map
        && draft.data.publication.currentVersionId == currentVersionId;
    }

    // Version deletion is authorized only for the archived owner of the target
    // version's lifecycle, with the pointer still present.
    //
    // If the target version is the pointer's current version, deletion is
    // allowed only when the public pointer is also removed in the same batch
    // (!existsAfter), so a client can never leave a dangling pointer.
    function archivedOwnerCanDeleteVersion(publicationId, userId, versionId) {
      let pointer = get(
        /databases/$(database)/documents/publishedPresentations/$(publicationId)
      );
      return isSignedIn()
        && resource.data.presentationId is string
        && resource.data.presentationId.size() > 0
        && pointer != null
        && pointer.data.currentVersionId is string
        && pointer.data.currentVersionId.size() > 0
        && archivedDraftOwnsPublication(
          publicationId,
          userId,
          resource.data.presentationId
        )
        && pointerVersionReferencesDraft(
          publicationId,
          pointer.data.currentVersionId,
          resource.data.presentationId
        )
        && (versionId != pointer.data.currentVersionId
            || !existsAfter(
              /databases/$(database)/documents/publishedPresentations/$(publicationId)
            ));
    }

    // The pointer's current version must reference the same presentationId as
    // the target version, tying both to the same publication lifecycle.
    function pointerVersionReferencesDraft(publicationId, currentVersionId, presentationId) {
      let version = get(
        /databases/$(database)/documents/publishedPresentations/$(publicationId)/versions/$(currentVersionId)
      );
      return version != null
        && version.data.presentationId == presentationId;
    }

    // Pointer deletion is coupled to current-version deletion in the same batch.
    //
    // Uses pre-operation get()/exists() for ownership discovery and
    // existsAfter() for the projected post-operation integrity requirement:
    // the current version must not survive the pointer.
    function archivedOwnerCanDeletePointer(publicationId, userId) {
      let pointer = get(
        /databases/$(database)/documents/publishedPresentations/$(publicationId)
      );
      return isSignedIn()
        && pointer != null
        && pointer.data.currentVersionId is string
        && pointer.data.currentVersionId.size() > 0
        && pointerVersionOwnedByArchivedDraft(
          publicationId,
          userId,
          pointer.data.currentVersionId
        )
        && !existsAfter(
          /databases/$(database)/documents/publishedPresentations/$(publicationId)/versions/$(pointer.data.currentVersionId)
        );
    }

    // Private draft deletion is restricted to the archived owner.
    //
    // A never-published draft may be deleted when publication metadata is
    // absent. A previously published draft may be deleted only after its
    // public pointer no longer exists in the pre-operation state. Malformed
    // publication metadata cannot bypass the published branch.
    function archivedOwnerCanDeleteDraft() {
      let resource = request.resource.data;
      return 'archivedAt' in resource
        && resource.archivedAt is timestamp
        && (!('publication' in resource)
            || (resource.publication is map
                && publicationMetadataHasValidShape(resource.publication)
                && !exists(
                  /databases/$(database)/documents/publishedPresentations/$(resource.publication.publicationId)
                )));
    }

    // ------------------------------------------------------------
    // PRIVATE DRAFTS
    // users/{userId}/presentations/{presentationId}
    // ------------------------------------------------------------
    match /users/{userId}/presentations/{presentationId} {
      allow read: if isPrivatePresentationOwner(userId);
      allow create, update: if isPrivatePresentationOwner(userId)
        && draftHasValidShape();
      allow delete: if isPrivatePresentationOwner(userId)
        && archivedOwnerCanDeleteDraft();
    }

    // ------------------------------------------------------------
    // PRIVATE PRESENTATION FOLDERS
    // users/{userId}/presentationFolders/{folderId}
    //
    // Flat Studio organization metadata, private to the authenticated owner.
    // Never exposed publicly.
    // ------------------------------------------------------------
    match /users/{userId}/presentationFolders/{folderId} {
      allow read, write: if isPrivatePresentationOwner(userId);
    }

    // ------------------------------------------------------------
    // PRIVATE CUSTOM LIBRARY
    // users/{userId}/customLibraryItems/{itemId}
    // ------------------------------------------------------------
    match /users/{userId}/customLibraryItems/{itemId} {
      allow read, write: if isPrivatePresentationOwner(userId)
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // ------------------------------------------------------------
    // PRIVATE CUSTOM LIBRARY PALETTES
    // users/{userId}/customLibraryPalettes/{paletteId}
    // ------------------------------------------------------------
    match /users/{userId}/customLibraryPalettes/{paletteId} {
      allow read, write: if isPrivatePresentationOwner(userId)
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // ------------------------------------------------------------
    // PRIVATE CUSTOM LIBRARY FONTS
    // users/{userId}/customLibraryFonts/{fontId}
    // ------------------------------------------------------------
    match /users/{userId}/customLibraryFonts/{fontId} {
      allow read, write: if isPrivatePresentationOwner(userId)
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // ------------------------------------------------------------
    // PRIVATE PRESENTATION NOTES
    // users/{userId}/presentations/{presentationId}/private/notes
    //
    // Private per-presentation notes, isolated from the canonical
    // Presentation document so notes writes can never affect
    // draftRevision, publication state, or published versions.
    // ------------------------------------------------------------
    match /users/{userId}/presentations/{presentationId}/private/notes {
      allow read, write: if isPrivatePresentationOwner(userId);
    }

    // ------------------------------------------------------------
    // PUBLIC PUBLICATION POINTER
    // publishedPresentations/{publicationId}
    // ------------------------------------------------------------
    match /publishedPresentations/{publicationId} {
      allow get: if true;

      allow list: if false;

      allow create: if publishedPointerIsAuthoritative(
        publicationId,
        request.auth.uid
      );

      allow update: if publishedPointerIsAuthoritative(
        publicationId,
        request.auth.uid
      );

      // Delete is restricted to the archived owner performing lifecycle
      // cleanup and is coupled to current-version deletion in the same batch.
      allow delete: if archivedOwnerCanDeletePointer(
        publicationId,
        request.auth.uid
      );
    }

    // ------------------------------------------------------------
    // PUBLIC IMMUTABLE PUBLISHED VERSIONS
    // publishedPresentations/{publicationId}/versions/{versionId}
    // ------------------------------------------------------------
    match /publishedPresentations/{publicationId}/versions/{versionId} {
      // Direct fetch of a known published version is intentionally public.
      allow get: if true;

      // Listing versions is restricted to the archived publication owner
      // performing lifecycle cleanup, with an explicit bounded query limit.
      // Ownership is resolved from the publication chain, never from a query
      // field-equality filter.
      allow list: if isArchivedPublicationOwner(publicationId, request.auth.uid)
        && request.query.limit is int
        && request.query.limit > 0
        && request.query.limit <= 100;

      // Creation is allowed only for a valid publish transaction verified
      // against the author's private draft pointer and snapshot, and only when
      // the atomically-advanced public pointer targets this exact version.
      allow create: if isSignedIn()
        && publishedVersionHasValidShape()
        && publishedVersionMatchesAuthoritativeDraft(
          publicationId,
          versionId,
          request.auth.uid
        )
        && publishedVersionMatchesNewPointer(publicationId, versionId);

      // Deletion is allowed only under the archived publication cleanup
      // contract; deleting the current version requires the pointer to be
      // removed in the same batch.
      allow delete: if archivedOwnerCanDeleteVersion(
        publicationId,
        request.auth.uid,
        versionId
      );

      // update is intentionally omitted. Published versions are immutable.
    }
  }
}

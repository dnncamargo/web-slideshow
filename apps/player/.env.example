# PowerShow Player Firebase Web configuration (Vite).
# These values correspond to the same Firebase Web project used by PowerShow Studio.
# Copy to .env.local and fill with your Firebase project values for published loading only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: used only by the temporary remote-control spike.
VITE_FIREBASE_DATABASE_URL=
